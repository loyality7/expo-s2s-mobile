{
  "name": "expo-s2s-mobile",
  "version": "0.1.0",
  "description": "Expo/React Native wrapper for Speech-to-Speech Mobile SDK",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "plugin": "app.plugin.js",
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-s2s-mobile",
    "S2SMobile"
  ],
  "repository": "https://github.com/loyality7/expo-s2s-mobile",
  "bugs": {
    "url": "https://github.com/loyality7/expo-s2s-mobile/issues"
  },
  "author": "loyality7 <sarathyadav112@gmail.com> (https://github.com/loyality7)",
  "license": "Apache-2.0",
  "homepage": "https://github.com/loyality7/expo-s2s-mobile#readme",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.1.1",
    "babel-preset-expo": "~57.0.0",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "^57.0.15",
    "expo-modules-core": "^57.0.12",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "prettier": "^3.0.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "peerDependencies": {
    "expo": "~57.0.15",
    "react": "19.2.3",
    "react-native": "0.86.2"
  }
